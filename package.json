{
  "name": "mi-progreso",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "native:sync": "node scripts/native/prepare-shell.mjs && cap sync",
    "native:assets": "node scripts/native/make-icons.mjs && capacitor-assets generate --ios --android --iconBackgroundColor \"#164735\" --splashBackgroundColor \"#f7f8f4\"",
    "native:ios": "npm run native:sync && cap open ios",
    "native:android": "npm run native:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@revenuecat/purchases-capacitor": "14.0.0",
    "jose": "6.2.12",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/web-push": "3.6.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "AVORA"
}
