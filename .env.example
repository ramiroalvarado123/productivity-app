# Supabase (públicas: también las usa el navegador)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Solo servidor
OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
FEEDBACK_WEBHOOK_URL=

# Notificaciones push (Web Push / VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Tiendas (App Store / Play Store)
# Mail de soporte que muestran /privacidad, /terminos y /soporte (las tiendas lo piden).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Solo al preparar la app nativa (npm run native:sync): dirección de la web que carga la app.
# Si no lo definís usa la de Vercel que figura en capacitor.config.ts.
CAP_SERVER_URL=

# Avisos push en la app nativa
# iPhone (APNs directo): clave .p8 de Apple. APNS_PRIVATE_KEY es el contenido del .p8 en una línea (saltos de línea como \n).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.avora.app
# "sandbox" solo para compilaciones de Xcode en modo desarrollo; TestFlight y App Store usan production.
APNS_ENV=production
# Android (Firebase Cloud Messaging): el JSON completo de la cuenta de servicio, pegado en una línea.
FCM_SERVICE_ACCOUNT=

# Suscripciones Pro (RevenueCat)
# Claves públicas del SDK, una por tienda (empiezan con appl_ y goog_).
NEXT_PUBLIC_REVENUECAT_IOS_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Clave secreta de la API de RevenueCat (sk_...): solo servidor.
REVENUECAT_SECRET_API_KEY=
# Texto que inventás; el mismo va en RevenueCat → Webhooks → Authorization header como "Bearer <texto>".
REVENUECAT_WEBHOOK_SECRET=
# "off" apaga el pago de demostración en la web (poner junto con supabase/pro-lockdown.sql).
NEXT_PUBLIC_WEB_PRO_DEMO=
